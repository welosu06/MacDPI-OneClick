diff --git a/core/RunDPI.sh b/core/RunDPI.sh
index c71f23b..729f81f 100755
--- a/core/RunDPI.sh
+++ b/core/RunDPI.sh
@@ -7,6 +7,12 @@ CIADPI_ARGS=""
 MAX_CONN=512
 [ -f settings.conf ] && . ./settings.conf
 
+# Bypass the TUN for desynchronized outbound packets on macOS.
+MACDPI_BIND_INTERFACE="$(/sbin/route -n get default 2>/dev/null | /usr/bin/awk '/interface:/{print $2; exit}')"
+[ -n "$MACDPI_BIND_INTERFACE" ] || { echo "No physical interface found" >&2; exit 1; }
+case "$MACDPI_BIND_INTERFACE" in utun*) echo "Default interface is a tunnel; refusing to loop" >&2; exit 1 ;; esac
+export MACDPI_BIND_INTERFACE
+
 # Each connection uses ~2 fds; make sure the fd limit clears the pool size. Run.sh
 # already raises this, but do it here too so a standalone run isn't fd-starved.
 ulimit -n $(( MAX_CONN * 4 )) 2>/dev/null || true
