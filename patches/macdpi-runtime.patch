diff --git a/core/NetworkReady.sh b/core/NetworkReady.sh
new file mode 100644
index 0000000..02f9f8e
--- /dev/null
+++ b/core/NetworkReady.sh
@@ -0,0 +1,27 @@
+#!/bin/bash
+physical_network() {
+    local iface addr
+    iface=$(/sbin/route -n get default 2>/dev/null | /usr/bin/awk '/interface:/{print $2; exit}')
+    case "$iface" in en[0-9]*) ;; *) return 1 ;; esac
+    addr=$(/usr/sbin/ipconfig getifaddr "$iface" 2>/dev/null) || return 1
+    case "$addr" in ''|0.*|169.254.*) return 1 ;; esac
+    printf '%s %s\n' "$iface" "$addr"
+}
+wait_for_network() {
+    local previous='' current='' stable=0
+    echo "Waiting for a stable physical network before starting DPI..."
+    while [ "$stable" -lt 3 ]; do
+        current=$(physical_network) || current=''
+        if [ -n "$current" ] && [ "$current" = "$previous" ]; then
+            stable=$((stable + 1))
+        else
+            stable=0
+        fi
+        previous="$current"
+        [ "$stable" -ge 3 ] || sleep 2
+    done
+    MACDPI_NETWORK_SIGNATURE="$current"
+    MACDPI_BIND_INTERFACE="${current%% *}"
+    export MACDPI_BIND_INTERFACE
+    echo "Physical network ready: $MACDPI_BIND_INTERFACE"
+}
diff --git a/core/RunDPI.sh b/core/RunDPI.sh
index c71f23b..6276311 100755
--- a/core/RunDPI.sh
+++ b/core/RunDPI.sh
@@ -7,6 +7,13 @@ CIADPI_ARGS=""
 MAX_CONN=512
 [ -f settings.conf ] && . ./settings.conf
 
+# Bypass the TUN for desynchronized outbound packets on macOS.
+. ./core/NetworkReady.sh
+if [ -z "${MACDPI_BIND_INTERFACE:-}" ]; then
+    wait_for_network || exit 1
+fi
+export MACDPI_BIND_INTERFACE
+
 # Each connection uses ~2 fds; make sure the fd limit clears the pool size. Run.sh
 # already raises this, but do it here too so a standalone run isn't fd-starved.
 ulimit -n $(( MAX_CONN * 4 )) 2>/dev/null || true
